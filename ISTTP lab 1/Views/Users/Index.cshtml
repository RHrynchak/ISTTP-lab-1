@using System.Security.Claims
@model IEnumerable<ISTTP_lab_1.Models.User>

@{
    ViewData["Title"] = "Index";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    string currentUserId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)!;
}


<h1>Index</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        Create new
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Username)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Role)
            </td>
            <td>
                @{
                    bool canEdit = isSuperAdmin || (item.Role != "Admin" && item.Role != "SuperAdmin") || item.Id.ToString() == currentUserId;
                }                
                @if (canEdit)
                {
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                }
                else
                {
                    <span class="text-muted border px-2 py-1 rounded">Захищено</span>
                }
            </td>
        </tr>
}
    </tbody>
</table>
