@model IEnumerable<ISTTP_lab_1.Models.PcConfig>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        Create new
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Os)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cpu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gpu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RamGb)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
             <td>
                @Html.DisplayFor(modelItem => item.User.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Os)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cpu.ModelName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gpu.ModelName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RamGb)
            </td>
            <td>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
