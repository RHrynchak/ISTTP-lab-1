<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ISTTP_lab_1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/cyborg.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ISTTP_lab_1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark mb-3" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Перевірка системних вимог ПК</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-area="" asp-controller="Checker" asp-action="Index">Перевірка характеристик</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="PcConfigs" asp-action="Index">Мої збірки</a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning fw-bold" href="#" role="button" data-bs-toggle="dropdown">
                                    База даних (Адмін)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-warning">
                                    <li><a class="dropdown-item text-white" asp-controller="Cpus" asp-action="Index">Процесори</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Gpus" asp-action="Index">Відеокарти</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Games" asp-action="Index">Ігри</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Requirements" asp-action="Index">Вимоги</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Users" asp-action="Index">Користувачі</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="text-info fw-bold">Привіт, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm mt-1">Вийти</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2 mt-1">
                                <a class="btn btn-info btn-sm fw-bold" asp-controller="Account" asp-action="Register">Реєстрація</a>
                            </li>
                            <li class="nav-item mt-1">
                                <a class="btn btn-primary btn-sm fw-bold" asp-controller="Account" asp-action="Login">Увійти</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer py-3">
        <div class="container text-light">
            <span class="text-white">&copy; 2026 - PC Check System - </span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
